APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://voicetranslate:voicetranslate@localhost:5432/voicetranslate
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
DEVICE=cpu
WHISPER_ENABLED=true
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=facebook/seamless-m4t-v2-large
TRANSLATION_DEVICE=cpu
TRANSLATION_COMPUTE_TYPE=default
TRANSLATION_SOURCE_LANGUAGE=
TRANSLATION_TARGET_LANGUAGE=
MAX_WEBSOCKET_FRAME_BYTES=65536
MAX_AUDIO_BUFFER_BYTES=1048576
MAX_AUDIO_SEGMENT_SECONDS=30
MAX_AUDIO_CHUNK_BYTES=65536
CORS_ORIGINS=http://localhost:3000
