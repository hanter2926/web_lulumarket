DJANGO_SECRET_KEY=replace-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.example
DEMO_PAYMENTS_ENABLED=False

# Database: use a managed PostgreSQL DATABASE_URL in production.
DATABASE_URL=postgresql://user:password@host:5432/accountbazaar
DB_ENGINE=sqlite
DB_NAME=accountbazaar
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Background jobs.
REDIS_URL=redis://localhost:6379/0

# Storage: set USE_S3=True for S3-compatible object storage.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# Payment integration is provider-neutral until a provider is selected.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
